<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reminder_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Compact Left Icon Badge -->
    <FrameLayout
        android:id="@+id/reminder_widget_compact_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/reminder_widget_badge_meal">

        <ImageView
            android:id="@+id/reminder_widget_compact_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="提醒类型"
            android:src="@drawable/ic_widget_meal" />
    </FrameLayout>

    <!-- Compact Middle Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reminder_widget_compact_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="今天"
                android:textColor="@color/widget_time_prefix"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_widget_compact_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="12:30"
                android:textColor="@color/widget_time_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_widget_compact_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="用餐提醒"
                android:textColor="@color/widget_item_label"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reminder_widget_compact_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="安伴提醒 · 点击查看"
            android:textColor="@color/widget_meta"
            android:textSize="9.5sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="打开安伴"
        android:src="@drawable/ic_widget_arrow" />

    <!-- Backward compatibility stub -->
    <TextView
        android:id="@+id/reminder_widget_summary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reminder_widget_synced"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
