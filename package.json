{
  "name": "anban",
  "version": "1.0.0",
  "private": true,
  "description": "安伴 Flutter 应用与 Go 后端的开发入口",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "android": "node --env-file-if-exists=.env scripts/run-mobile.mjs android",
    "ios": "node --env-file-if-exists=.env scripts/run-mobile.mjs ios",
    "web": "node --env-file-if-exists=.env scripts/run-mobile.mjs web",
    "backend": "node --env-file-if-exists=.env scripts/run-backend.mjs",
    "admin": "node --env-file-if-exists=.env admin/node_modules/next/dist/bin/next dev admin --port 8025 --hostname 127.0.0.1",
    "admin:build": "npm --prefix admin run build",
    "admin:lint": "npm --prefix admin run lint",
    "test:scripts": "node --test scripts/*.test.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
