ANBAN_ADDR=127.0.0.1:8024
ANBAN_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# PostgreSQL TCP port, not a web console. URL-encode special characters in password.
DATABASE_URL=postgres://app_user:CHANGE_ME@db.example.com:5432/app_db?sslmode=require
# Use the S3 API endpoint, not the console. No scheme or /login here.
MINIO_ENDPOINT=s3.example.com:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_BUCKET=app-files
TZ=Asia/Shanghai

# Docker host binding; container always listens on 0.0.0.0:8024.
ANBAN_BIND_IP=127.0.0.1
ANBAN_PORT=8024

# Flutter API address, forwarded as --dart-define by npm run android/ios/web.
# Leave blank for automatic localhost / Android emulator 10.0.2.2 defaults.
ANBAN_API_URL=http://10.0.2.2:8024

# Android update: these values seed a NEW database once. Use the admin UI afterwards.
# VERSION_CODE must match the APK's actual Android versionCode and increase per release.
ANBAN_ANDROID_VERSION_CODE=
ANBAN_ANDROID_VERSION_NAME=
ANBAN_ANDROID_DOWNLOAD_URL=
ANBAN_ANDROID_RELEASE_NOTES=

# Grant existing registered accounts access to the admin UI; comma-separated.
# Leave blank to disable admin access. Register the account BEFORE setting this.
ANBAN_ADMIN_USERS=
# Next.js server-to-server API address, not the Flutter API address.
ANBAN_ADMIN_API_URL=http://127.0.0.1:8024
ANBAN_ADMIN_PORT=8025
# Public HTTPS Go backend origin; generated APK download links use this domain.
ANBAN_PUBLIC_URL=
