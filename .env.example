# 本地运行与根目录 Docker Compose 共用的环境配置。
# .env.example 保存示例值；.env 保存实际配置，两者保持相同字段和分组。
# 首次使用复制为 .env 并填写真实配置；已有 .env 只补齐缺项，不覆盖原值。

# ---------- PostgreSQL（必填） ----------
# 数据库须已创建，账号需能创建表；使用数据库 TCP 地址，不是管理控制台。
# 密码特殊字符需 URL 编码；sslmode 按数据库实际 TLS 配置填写。
DATABASE_URL='postgres://app_user:CHANGE_ME@db.example.com:5432/app_db?sslmode=require'

# ---------- MinIO / S3（必填） ----------
# 使用 S3 API 地址，不带协议或路径；Docker 部署时须能从容器访问。
# 示例为 HTTP API；若实际使用 HTTPS，将 MINIO_USE_SSL 设为 true。
MINIO_ENDPOINT=s3.example.com:9000
MINIO_ACCESS_KEY='CHANGE_ME'
MINIO_SECRET_KEY='CHANGE_ME'
MINIO_USE_SSL=false
# 使用已创建的私有桶；已有部署保持原桶名。
MINIO_BUCKET=app-files
# 单引号可保留密钥中的 $ 等字符，避免 Compose 将其当作变量展开。

# ---------- 服务监听地址 ----------
# 本地后端与 Docker 后端宿主机映射共用；填写 IP:端口，不带协议。
# 默认供同机 HTTPS 反向代理访问；需要外部连接时可改为 0.0.0.0:端口。
ANBAN_ADDR=127.0.0.1:8024
# 本地管理端与 Docker 管理端宿主机映射共用。
ANBAN_ADMIN_ADDR=127.0.0.1:8025

# ---------- 客户端连接地址 ----------
# 本地管理端连接 Go 后端的地址；根目录 Compose 自动设为 http://backend:8024。
ANBAN_ADMIN_API_URL=http://127.0.0.1:8024
# npm run android/ios/web 将此值传入 Flutter；正式客户端填写公开 HTTPS 后端地址。
# 留空时自动使用本机地址，Android 模拟器为 10.0.2.2，其他平台为 localhost。
ANBAN_API_URL=http://10.0.2.2:8024
# Flutter Web 跨域访问 Go 后端的网页来源，多个用英文逗号分隔。
# 下方为本地 Web 预览地址；正式 Web 填实际来源，原生 App 和管理端可留空。
ANBAN_ORIGINS=http://localhost:7357,http://127.0.0.1:7357

# ---------- 管理员与 APK 发布 ----------
# 独立管理端账号，无需在 App 注册；3–32 位字母、数字或下划线，不区分大小写。
ANBAN_ADMIN_USERNAME=admin
# 自行设置密码：至少 6 个字符，最多 72 个 UTF-8 字节；留空禁用管理端登录。
# 可用单引号包裹包含 $、# 或空格的密码。没有内置默认密码。
ANBAN_ADMIN_PASSWORD=
# 修改账号或密码后重新启动后端，所有管理端会话失效；App 账号和会话不受影响。
# 上传 APK 时必填：公开 HTTPS Go 后端域名，如 https://api.example.com。
# 不填管理端或 MinIO 域名，不带路径、查询参数，用于生成 APK 下载链接。
ANBAN_PUBLIC_URL=
