# Used by admin/compose.yaml. Must be reachable INSIDE the admin container.
# Do not use 127.0.0.1 here to refer to a backend running outside this container.
ANBAN_ADMIN_API_URL=https://api.example.com
ANBAN_ADMIN_BIND_IP=127.0.0.1
ANBAN_ADMIN_PORT=8025

# Administrator authorization is configured on the GO BACKEND with ANBAN_ADMIN_USERS.
# There is no built-in default username/password; use an authorized registered account.
