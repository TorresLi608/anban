# Used by admin/compose.yaml. Must be reachable INSIDE the admin container.
# Do not use 127.0.0.1 here to refer to a backend running outside this container.
ANBAN_ADMIN_API_URL=https://api.example.com
# Host IP and port, published to the admin container's port 8025.
ANBAN_ADMIN_ADDR=127.0.0.1:8025

# Set ANBAN_ADMIN_USERNAME and ANBAN_ADMIN_PASSWORD on the GO BACKEND.
# These independent admin credentials do not require an App account.
